<!-- qpos0 equals each joint's ref: the pose the CAD was exported in,
     which sits at the lower hard stop (J5 is 7 deg inside it).
     "home" is the mid-travel pose: every joint at 0 deg, gripper open.

     This file is spliced into robot.xml by onshape-to-robot via the
     "additional_xml" option in config.json, so it survives regeneration
     instead of being overwritten like hand-edited parts of robot.xml. -->
<keyframe>
  <key name="home" qpos="0 0 0 0 0 0 0 0" ctrl="0 0 0 0 0 0 0"/>
</keyframe>
